{
  "name": "events-api",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 public ingest API for career market events",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "node src/events_validate.test.js && tsx --test src/app.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
