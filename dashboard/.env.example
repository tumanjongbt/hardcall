# API origin only (scheme + host[:port]). No path, no secrets.
# Vite inlines VITE_* into the browser bundle. The dashboard fetches this origin
# only (GET /api/events, GET /api/events/stream, GET /api/insights, POST /api/events).
# The API is CORS-open (Access-Control-Allow-Origin: *) so a local or hosted
# dashboard origin can call it. Restrict CORS when ingest auth lands.
VITE_EVENTS_API_URL=https://hardcall-api.onrender.com
