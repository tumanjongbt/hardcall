# Cloud Postgres (sslmode=require). Neon or Supabase.
# Supabase: use the transaction pooler (*.pooler.supabase.com:6543, user postgres.<project-ref>).
# Direct db.<ref>.supabase.co may not resolve from some environments.
# Neon: prefer the direct host for npm run migrate; pooled is fine for the API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Listen address (defaults shown).
PORT=3000
HOST=0.0.0.0

# Production must be false so seed / playground / synthetic CLI cannot write.
# Unset + NODE_ENV=production also disables demo. Staging: HARDCALL_ALLOW_DEMO=true
HARDCALL_ALLOW_DEMO=false

# Optional bulk-feed URL overrides (keyless official downloads).
# APPRENTICESHIP_CSV_URL=https://www.apprenticeship.gov/sites/default/files/wps/oa_partner_sponsors.csv
# SCORECARD_INSTITUTION_URL=https://ed-public-download.scorecard.network/downloads/Most-Recent-Cohorts-Institution_06102026.zip
# SCORECARD_FIELD_OF_STUDY_URL=https://ed-public-download.scorecard.network/downloads/Most-Recent-Cohorts-Field-of-Study_06102026.zip
# ONET_OCCUPATION_URL=https://www.onetcenter.org/dl_files/database/db_31_0_csv/occupation_data.csv
# BLS_OEWS_URL=https://www.bls.gov/news.release/ocwage.t01.htm

# Optional later (not required for Phase A keyless ingest):
# SCORECARD_API_KEY=
# BLS_API_KEY=
# ONET_API_KEY=
# DOL_API_KEY=
